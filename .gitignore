# Compiled frontend assets, built on the server during deployment. Three rules
# said this already; a handful of files were committed under them anyway, so
# the deploy kept restoring a stale manifest over a good one.
build/public/build
# Where a deployment builds before it swaps, and what it keeps to fall back on.
build/public/build-staging
build/public/build-previous

# Agent credentials and session transcripts. This repository is public, so
# anything committed here is world-readable the moment it is pushed. auth.json
# in particular holds an API key and OAuth refresh tokens.
# The speckit prompt templates under .codex/prompts/ stay tracked on purpose.
.codex/auth.json
.codex/history.jsonl
.codex/sessions/

# curl cookie jars — session cookies, never source.
cookies.txt
**/cookies.txt
